PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (e.g. http://localhost:5173,http://localhost:5174)
CLIENT_URL=http://localhost:5173,http://localhost:5174
# Whether to serve the built React client from client/dist (default: true)
SERVE_CLIENT=true
JWT_SECRET=your-secure-jwt-secret
JWT_DEV_FALLBACK_SECRET=replace_with_a_random_development_secret
MONGODB_URI=mongodb://127.0.0.1:27017/edl_ims
# Whether "From Whom Received" (sender) is mandatory when recording received transactions (default: false)
REQUIRE_RECEIVED_SENDER=false
# Maximum size in KB for voucher and transaction image attachments (default: 800)
ATTACHMENT_MAX_KB=800
# Proxy configuration: false (default), true, number of hops (e.g. 1), or comma-separated proxy IPs
TRUST_PROXY=false
