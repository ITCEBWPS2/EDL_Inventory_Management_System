{
  "name": "edl-ims-server",
  "version": "1.0.0",
  "description": "EDL Inventory Management System Express REST API with MongoDB",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/**/*.test.js",
    "seed": "node src/scripts/seed.js",
    "migrate:units": "node src/scripts/migrate-units-horana.js",
    "migrate:unit-order": "node src/scripts/migrate-unit-order.js",
    "migrate:unit-locations": "node src/scripts/migrate-unit-locations.js",
    "migrate:unit-codes": "node src/scripts/migrate-unit-codes.js",
    "import:backup": "node src/scripts/import-backup.js",
    "cleanup:junk-item": "node src/scripts/remove-junk-item.js",
    "migrate:chair-types": "node src/scripts/migrate-chair-type-names.js",
    "cleanup:received-dates": "node src/scripts/clear-autofilled-received-dates.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9"
  }
}
